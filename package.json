{
  "name": "media-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "biome check . && pnpm check:function-length",
    "typecheck": "tsc && pnpm -r typecheck",
